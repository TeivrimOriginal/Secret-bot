<?xml version="1.0" encoding="utf-8"?>
<!-- Разрешаем обычный http: туннели вроде trycloudflare и localhost
     работают по http, а страницу без этого не открыть. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
