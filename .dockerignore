# Что НЕ должно попасть в образ.
#
# Смысл: в образ идёт только то, что нужно боту и сайту. Лишнее
# раздувает образ и, что хуже, может притащить с собой локальные данные
# (базу с ключами, `.env` с токеном, виртуальное окружение на полгига).

# Локальное окружение и кэши
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Локальные данные: база с ключами, passkey и мастер-ключом.
# В образ им нельзя: на хостинге база должна быть на постоянном томе.
*.db
*.db-journal
*.db-wal
*.db-shm
links.db

# Секреты
secret-bot.env
.env
.env.*

# Android: это отдельный проект, боту не нужен
android/

# Сборка Windows
build/

# Git и документация — в образе не нужны
.git/
.gitignore
README.md
DEPLOY.md
tests/
