; Настройки Secret-bot. Изменения вступают в силу при следующем запуске.
; Строки, начинающиеся с ; или #, игнорируются.
; Этот файл установщик кладёт в %APPDATA%\SecretBot\secret-bot.env
; Переменные окружения имеют приоритет над этим файлом.

; Токен бота от @BotFather — обязателен.
BOT_TOKEN=

; Публичный адрес сайта БЕЗ слеша на конце.
; WebAuthn (passkey) работает только по HTTPS. Для локальной проверки
; можно оставить http://localhost:8080
BASE_URL=http://localhost:8080

; Поднимать ли сайт (1 — да). Без сайта бот только шифрует и даёт ссылки.
ENABLE_WEB=1
WEB_HOST=0.0.0.0
WEB_PORT=8080

; База ссылок. По умолчанию — %APPDATA%\SecretBot\links.db
; DB_PATH=

; Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
